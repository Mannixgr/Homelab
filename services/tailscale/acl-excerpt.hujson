// Excerpt of the tailnet policy relevant to CI deploys (sanitized).
// Source of truth is the Tailscale admin console.
{
	"tagOwners": {
		"tag:ci":     ["autogroup:admin"],
		"tag:resale": ["autogroup:admin"],
	},

	// CT104 (resale dashboard) may use Funnel.
	"nodeAttrs": [
		{
			"target": ["tag:resale"],
			"attr":   ["funnel"],
		},
	],

	// Deliberately NO grants with src tag:resale: default deny, so a
	// compromised CT104 cannot reach any other tailnet node.

	"grants": [
		{
			"src": ["tag:ci"],
			"dst": ["192.168.1.20"],
			"ip":  ["tcp:22"],
		},
		// CI deploys to the resale dashboard: SSH only, forced command on the CT.
		{
			"src": ["tag:ci"],
			"dst": ["tag:resale"],
			"ip":  ["tcp:22"],
		},
	],
}
